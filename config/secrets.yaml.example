# Copy this file to secrets.yaml in the same folder and fill in your own
# values. secrets.yaml is gitignored and should never be committed.

wifi_ssid: "your-network-name"
wifi_password: "your-network-password"

# Generate this from the ESPHome dashboard when you add the device
# (or leave blank on first flash and let it generate one for you).
api_key: "REPLACE_WITH_BASE64_32BYTE_KEY"
